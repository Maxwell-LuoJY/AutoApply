# Local secrets. `uv run jobagent init` copies this file to .env (git-ignored, mode 600). Never commit .env.
# 本地密钥。`uv run jobagent init` 会复制成 .env（不进 git）。不要提交或分享 .env。

# Any OpenAI-compatible chat endpoint (OpenAI, DeepSeek, OpenRouter, a local vLLM / Ollama server, ...).
# 任意 OpenAI 兼容接口。
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
# More keys for the same endpoint and model (rate limits are counted per key): LLM_API_KEY_2 … LLM_API_KEY_9
# 同一接口的更多 key（限流按 key 分别计算）
# LLM_API_KEY_2=

# Optional: Gmail over IMAP, to read verification codes / activation links and count confirmation emails.
# Google Account → Security → 2-Step Verification → App passwords. Leave empty to skip.
# 可选：用 Gmail 应用专用密码读取验证码、激活链接和申请确认信。不用就留空。
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
